+    // READ: all viewings booked by one tenant, with the property details.
+    fun getTenantViewings(tenantId: Long): Cursor {
+
+        return readableDatabase.rawQuery(
+            """
+            SELECT
+                v.$COL_VIEWING_ID,
+                v.$COL_PROPERTY_ID,
+                v.$COL_VIEWING_DATE,
+                v.$COL_VIEWING_SLOT,
+                p.$COL_PROPERTY_TITLE,
+                p.$COL_PROPERTY_LOCATION
+            FROM $TABLE_VIEWINGS v
+            INNER JOIN $TABLE_PROPERTIES p
+                ON v.$COL_PROPERTY_ID = p.$COL_PROPERTY_ID
+            WHERE v.$COL_VIEWING_TENANT_ID = ?
+            """.trimIndent(),
+            arrayOf(tenantId.toString())
+        )
+    }
+
+    // READ: one viewing (only if it belongs to this tenant).
+    fun getViewingById(viewingId: Long, tenantId: Long): Cursor {
+
+        return readableDatabase.rawQuery(
+            """
+            SELECT
+                v.$COL_VIEWING_ID,
+                v.$COL_PROPERTY_ID,
+                v.$COL_VIEWING_DATE,
+                v.$COL_VIEWING_SLOT,
+                p.$COL_PROPERTY_TITLE,
+                p.$COL_PROPERTY_LOCATION
+            FROM $TABLE_VIEWINGS v
+            INNER JOIN $TABLE_PROPERTIES p
+                ON v.$COL_PROPERTY_ID = p.$COL_PROPERTY_ID
+            WHERE v.$COL_VIEWING_ID = ? AND v.$COL_VIEWING_TENANT_ID = ?
+            """.trimIndent(),
