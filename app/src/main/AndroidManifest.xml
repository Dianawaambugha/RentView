        <activity android:name=".ui.activities.AllPropertiesActivity" android:exported="false" />
        <activity android:name=".ui.activities.PropertyListActivity" android:exported="false" />
        <activity android:name=".ui.activities.PropertyDetailsActivity" android:exported="false" />
        <activity android:name=".ui.activities.ScheduleViewingActivity" android:exported="false" />
        <activity android:name=".ui.activities.MyViewingsActivity" android:exported="false" />
        <activity android:name=".ui.activities.HomeActivity" android:exported="false" />
        <activity android:name=".ui.activities.PropertyApprovalsActivity" android:exported="false" />
