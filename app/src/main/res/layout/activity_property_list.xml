<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="RentView"
        android:textColor="#173B57"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Explore Properties"
        android:textColor="#173B57"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Tap a property to see its details and book a viewing."
        android:textColor="#757575"
        android:textSize="15sp" />

    <!-- Search by title or location -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#FFFFFF"
        android:hint="Search by title or location"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:minHeight="48dp"
        android:padding="12dp"
        android:textColor="#263746"
        android:textColorHint="#8A97A3"
        android:textSize="15sp" />

    <!-- Filters: price range and minimum bedrooms -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etMinRent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:hint="Min rent"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="#263746"
            android:textColorHint="#8A97A3"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMaxRent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:hint="Max rent"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="#263746"
            android:textColorHint="#8A97A3"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etMinBedrooms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:hint="Min beds"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="#263746"
            android:textColorHint="#8A97A3"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvResultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Showing 0 of 0 properties"
        android:textColor="#315D78"
        android:textSize="14sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProperties"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressProperties"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/layoutPropertiesState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPropertiesState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="No properties available yet."
                android:textColor="#263746"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnPropertiesStateAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#315D78"
                android:text="Try again"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </FrameLayout>

    <Button
        android:id="@+id/btnPropertiesBack"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#DCE5EC"
        android:text="Back"
        android:textColor="#173B57"
        android:textSize="16sp" />

</LinearLayout>
