<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Property"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Property Title" />

        <EditText
            android:id="@+id/editPropertyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter property title"
            android:inputType="textCapSentences"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/editPropertyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter property location"
            android:inputType="textCapSentences"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monthly Rent (KES)"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/editPropertyRent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter monthly rent"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Number of Bedrooms"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/editPropertyBedrooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter number of bedrooms"
            android:inputType="number"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/editPropertyDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top|start"
            android:hint="Describe the property"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="100dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Property Photos"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal">

            <LinearLayout
                android:id="@+id/currentPropertyPhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Replacement Photos (Optional)"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select new photos only if you want to replace the existing photos. The replacement will require admin approval."
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnChooseReplacementPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Replacement Photos" />

        <TextView
            android:id="@+id/tvSelectedReplacementPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No replacement photos selected"
            android:padding="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal">

            <LinearLayout
                android:id="@+id/selectedReplacementPhotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <Button
            android:id="@+id/btnSubmitPropertyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="52dp"
            android:text="Submit Changes for Approval" />

    </LinearLayout>

</ScrollView>