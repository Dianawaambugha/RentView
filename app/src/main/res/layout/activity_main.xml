<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F5F7FA">

    ```
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RentView"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="#173B57"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find your next home."
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#263746"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Discover rental properties, explore available homes, and schedule viewings with ease."
        android:textSize="16sp"
        android:textColor="#667788"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Get Started"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#173B57" />

    <Button
        android:id="@+id/btnAdminAccess"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Administrator Login"
        android:textSize="16sp"
        android:textColor="#173B57"
        android:backgroundTint="#DCE6EF" />
    ```

</LinearLayout>
